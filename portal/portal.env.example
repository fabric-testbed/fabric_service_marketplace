# FABRIC Service Portal configuration
# Copy to portal.env and replace every "changeme" value. Lines are KEY=value
# (no spaces around =, no quotes).

# ── Required ──

# Portal's public hostname (e.g. portal.example.org), or its public IP when
# testing without a domain. deploy.sh uses it for Nginx and the TLS cert.
PORTAL_SERVER_NAME=changeme-portal-hostname-or-public-ip

# UUID of the FABRIC project whose members may register services
# (from the project's page on the FABRIC portal). Format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PORTAL_PROJECT_ID=changeme-fabric-project-uuid

# Gateway VM's address: https:// + its FABNetv4Ext public IPv4.
GATEWAY_URL=https://changeme-gateway-public-ip

# Shared secret. Must be identical to GATEWAY_SHARED_SECRET in gateway.env.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_SHARED_SECRET=changeme-shared-secret

# How to check the gateway's TLS certificate:
#   /full/path/to/gateway.crt  - copy of the gateway VM's gateway.crt (recommended)
#   true                       - gateway has a certificate from a public authority
#   false                      - no check (testing only)
GATEWAY_TLS_VERIFY=changeme-path-to-gateway.crt

# ── Usually left as is ──

# Where the "Sign in with FABRIC" button on /login goes: the start of the
# automated login (e.g. CILogon), once it exists. Unset = button disabled;
# testers log in on /token_test instead.
# PORTAL_LOGIN_URL=/auth/fabric/start

# Only accept FABRIC tokens with this scope. 'service' tokens only identify the
# user, so they are safe to pass to service nodes; 'resource' tokens can create
# and delete slices as the user and are refused. Empty = accept any scope.
PORTAL_REQUIRED_TOKEN_SCOPE=service

# FABRIC user service, used to look up a token's user and projects.
# FABRIC_UIS_URL=https://uis.fabric-testbed.net

# Service nodes must have addresses in this network (FABRIC's FABnetv6 range).
PORTAL_SERVICE_NODE_NETWORK=2602:fcfb::/40

# Seconds to wait for the gateway.
GATEWAY_TIMEOUT=15

# Optional. If unset, a key is generated and stored in portal/.secret_key
# PORTAL_SECRET_KEY=

# Optional. Default is SQLite in portal/instance/portal.db
# PORTAL_DATABASE_URI=sqlite:///portal.db

# Set both to false only when running locally over plain http without Nginx.
PORTAL_BEHIND_PROXY=true
PORTAL_SECURE_COOKIES=true
