# FABRIC Service Gateway configuration
# Copy to gateway.env and replace every "changeme" value. Lines are KEY=value
# (no spaces around =, no quotes).

# ── Required ──

# This VM's FABNetv4Ext public IPv4 (see `ip -br -4 addr`). deploy.sh uses it
# for the TLS certificate.
GATEWAY_PUBLIC_IP=changeme-gateway-public-ip

# Shared secret. Must be identical to GATEWAY_SHARED_SECRET in portal.env.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_SHARED_SECRET=changeme-shared-secret

# Who may call the gateway: the IP the portal's requests come FROM, as IP/32.
# Comma-separate several. On the portal VM, `ip route get <gateway IP>` shows it
# after "src"; or read "client:" in /var/log/nginx/error.log here after a refused call.
GATEWAY_ALLOWED_SOURCES=changeme-portal-public-ip/32

# ── Usually left as is ──

# Where the gateway may forward to (FABRIC's FABnetv6 range).
GATEWAY_ALLOWED_TARGETS=2602:fcfb::/40

# Seconds to wait for a service node to answer.
GATEWAY_REQUEST_TIMEOUT=10

# true when running behind the bundled Nginx (normal). false only for local testing.
GATEWAY_BEHIND_PROXY=true
